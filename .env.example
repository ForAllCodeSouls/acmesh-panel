# ============ 必填 ============
# 面板密码：至少 12 位，且必须同时包含大写、小写和数字。
# 请自己生成，不要复用文档 / 仓库里出现过的任何密码：
#   openssl rand -base64 24
# 把生成结果整行粘贴到下面（只替换等号右边）。
# 仅首次启动（数据库里还没有密码时）用于初始化；之后在设置页修改密码会持久保存，
# 重启不会被这里的值覆盖。忘记密码时才用下面的 ACME_PANEL_RESET_CREDENTIALS 重置。
ACME_PANEL_PASSWORD=<粘贴 openssl rand -base64 24 的输出>

# ============ 镜像 ============
# 要使用的 GHCR 镜像标签。不填默认 latest；可固定版本，如 0.1.74
ACMESH_IMAGE_TAG=latest

# ============ 账号 ============
# 面板登录账号；仅首次启动写入数据库，之后以 Web 上的修改为准（默认 admin）
ACME_PANEL_USER=admin

# 忘记密码时的应急开关：设为 1 并配置上面两项，重启一次显式重置账号密码。
# 重置完务必改回 0 / 删除，否则每次启动都会重置。日常保持关闭。
# ACME_PANEL_RESET_CREDENTIALS=0

# ============ 常用可选配置 ============
# 默认 CA：letsencrypt / zerossl / buypass / google / letsencrypt_test（测试环境）
ACME_PANEL_CA=letsencrypt

# ACME 账户邮箱：签发时作为默认邮箱，Web 里可按域名覆盖；留空用 acme.sh 安装时的账户
ACME_PANEL_EMAIL=you@example.com

# 内置续期调度：1 开启（每 12 小时 acme.sh --cron），0 关闭（仍检查临期）
ACME_PANEL_CRON=1

# 同时运行的 acme.sh 任务数，默认 2；服务器性能低可调 1
# ACME_PANEL_PARALLEL=2

# HTTPS 由 nginx/Caddy 反代终结，面板固定 HTTP、不提供任何 Cookie/HSTS 开关。
# 反代透传 X-Forwarded-Proto: https 时，面板自动给 Cookie 加 Secure 并下发 HSTS。
# 旧的 ACME_PANEL_COOKIE_SECURE / ACME_PANEL_TLS_CERT / ACME_PANEL_TLS_KEY 已移除，写了也无效。

# 可选：强制只允许 HTTPS 访问。
# =1 强制开启：通过 IP / 端口的 HTTP 直连会被静默断连（页面和 API 都打不开，
#    效果等同于访问一个空端口），只有反代过来的 HTTPS 请求可用；/api/health 例外。
# =0 强制关闭（反代漏传 XFP、把自己锁在外面时的应急恢复入口，界面开关同步锁定）。
# 留空/注释：使用设置页保存的开关（默认关闭）。
# 前提：nginx/Caddy 必须向面板透传 X-Forwarded-Proto: https，否则 HTTPS 也打不开。
# ⚠ 改这个值后必须 `docker compose up -d` 重建容器；restart 不会刷新环境变量。
# ACME_PANEL_FORCE_HTTPS=1

# 反代与面板同一网络时设为 1：从 X-Forwarded-For 取真实 IP（审计 / 登录限流）
# 只有反代完全可信时才开，否则攻击者可伪造该头绕过限流
# 若启用「安全中心 → IP 白名单」且有反代，必须设为 1，否则白名单看到的是代理 IP
ACME_PANEL_TRUST_PROXY=0
# 可信反代层数：X-Forwarded-For 从右往左取第 N 个地址（默认 1）
ACME_PANEL_TRUST_PROXY_HOPS=1

# ============ 证书同步（可选） ============
# 同步目录：签发/续期后按文件名把新证书/私钥写进这些目录里的对应文件
# 多个目录用英文逗号或分号分隔；需在 docker-compose.yml 的 volumes 里挂载同名路径
# 留空表示禁用同步
# ACME_PANEL_SYNC_DIR=/certs,/srv/ssl

# ============ 路径（一般不用改） ============
# 容器内监听地址，映射到宿主 8800；改动需同步改 compose 的 ports
# ACME_PANEL_LISTEN=0.0.0.0:8080
# acme.sh 的 home（存证书与账户密钥）
# ACME_HOME=/acme.sh
# acme.sh 可执行文件路径，留空自动用 $ACME_HOME/acme.sh
# ACME_BIN=/acme.sh/acme.sh
# 面板数据目录（状态、密钥、审计、任务记录、部署输出）
# ACME_PANEL_DATA=/data

# ============ 仅测试用 ============
# 允许 Webhook 指向私网地址（SSRF 防护默认禁止）；生产环境勿开
# ACME_PANEL_ALLOW_LOCAL_WEBHOOK=0

# ⚠ 以上任何环境变量改动后都要 `docker compose up -d` 重建容器才生效，
#   `docker compose restart` 只重启进程，不会把新值注入容器。

TZ=Asia/Shanghai
