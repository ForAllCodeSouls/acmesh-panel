# 要使用的镜像标签（GHCR）。不填默认 latest；也可用 0.0.2 固定版本
ACMESH_IMAGE_TAG=latest

# 复制为 .env 后修改；至少 12 位，建议用 openssl rand -base64 24 生成
ACME_PANEL_PASSWORD=change-me-to-a-long-random-password

# 面板登录账号
ACME_PANEL_USER=admin

# 通过 HTTPS 反代访问时设为 1（Cookie Secure + HSTS）
ACME_PANEL_COOKIE_SECURE=0

# 反代与面板同一网络时设为 1，才能拿到真实客户端 IP（用于审计与登录限流）
ACME_PANEL_TRUST_PROXY=0

# Let's Encrypt 账户邮箱
ACME_PANEL_EMAIL=you@example.com

# 默认 CA：letsencrypt / zerossl / buypass / google
ACME_PANEL_CA=letsencrypt

# 证书同步目录（需同时在 docker-compose.yml 里挂载对应卷）
# 例如挂载 /home/web/certs:/certs 后设为 /certs，签发/续期会自动覆盖匹配文件
# ACME_PANEL_SYNC_DIR=/certs

TZ=Asia/Shanghai
