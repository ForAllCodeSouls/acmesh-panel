# ============ 必填 ============
# 面板密码：至少 12 位，建议用 openssl rand -base64 24 生成
ACME_PANEL_PASSWORD=change-me-to-a-long-random-password

# ============ 镜像 ============
# 要使用的 GHCR 镜像标签。不填默认 latest；可固定版本，如 0.1.17
ACMESH_IMAGE_TAG=latest

# ============ 账号 ============
# 面板登录账号（仅首次初始化写入）
ACME_PANEL_USER=admin

# ============ 常用可选配置 ============
# 默认 CA：letsencrypt / zerossl / buypass / google / letsencrypt_test（测试环境）
ACME_PANEL_CA=letsencrypt

# ACME 账户邮箱：签发时作为默认邮箱，Web 里可按域名覆盖；留空用 acme.sh 安装时的账户
ACME_PANEL_EMAIL=you@example.com

# 内置续期调度：1 开启（每 12 小时 acme.sh --cron），0 关闭（仍检查临期）
ACME_PANEL_CRON=1

# 同时运行的 acme.sh 任务数，默认 2；服务器性能低可调 1
# ACME_PANEL_PARALLEL=2

# HTTPS 反代时设为 1：Cookie 加 Secure 标记并下发 HSTS；纯 HTTP 本地访问保持 0
ACME_PANEL_COOKIE_SECURE=0

# 反代与面板同一网络时设为 1：从 X-Forwarded-For 取真实 IP（审计 / 登录限流）
# 只有反代完全可信时才开，否则攻击者可伪造该头绕过限流
ACME_PANEL_TRUST_PROXY=0

# 面板自己终结 TLS（可选）：把证书和私钥挂进容器后填容器内路径，两个都要填
# ACME_PANEL_TLS_CERT=/certs/fullchain.pem
# ACME_PANEL_TLS_KEY=/certs/key.pem

# ============ 证书同步（可选） ============
# 同步目录：签发/续期后按文件名把新证书/私钥写进这些目录里的对应文件
# 多个目录用英文逗号或分号分隔；需在 docker-compose.yml 的 volumes 里挂载同名路径
# 留空表示禁用同步
# ACME_PANEL_SYNC_DIR=/certs,/srv/ssl

# ============ 路径（一般不用改） ============
# 容器内监听地址，映射到宿主 8800；改动需同步改 compose 的 ports
# ACME_PANEL_LISTEN=0.0.0.0:8080
# acme.sh 的 home（存证书与账户密钥）
# ACME_HOME=/acme.sh
# 面板数据目录（状态、密钥、审计、任务记录、部署输出）
# ACME_PANEL_DATA=/data

TZ=Asia/Shanghai
